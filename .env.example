PORT=4000
MONGODB_URI=mongodb://localhost:27017/tlm_rule_repository
# NODE_ENV gates secret handling. It MUST be "development" or "test" for the placeholder secrets
# below to be accepted. Anything else — "production", "staging", an unrecognized value, or leaving
# NODE_ENV unset — makes the app refuse to boot unless JWT_SECRET (and SEED_ADMIN_PASSWORD, for the
# seed script) are set to real, non-placeholder values. This prevents a deploy from silently
# running on the committed dev secret and handing out forgeable admin tokens.
NODE_ENV=development
# Set a strong random secret before any non-local use (and set NODE_ENV away from development).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- Used by docker-compose.yml (not read by the app directly) ---
# Credentials MongoDB is started with in the Compose stack. Override before any non-local use.
MONGO_ROOT_USERNAME=tlm_root
MONGO_ROOT_PASSWORD=local-dev-only-change-me

# Comma-separated allowlist of browser origins for CORS. If unset, all origins are allowed
# (fine for local/dev; requests still require a bearer token) — but only when NODE_ENV is
# "development" or "test". Anywhere else, an unset CORS_ORIGIN refuses to boot; set a real list.
# CORS_ORIGIN=https://admin.example.com,https://app.example.com

# Maker-checker: require a different user to approve a global policy than the one who
# submitted it. Set to false only for solo dev/demo use.
REQUIRE_APPROVAL_SEPARATION=true

# Used by `npm run seed` to create the first PLATFORM_ADMIN user. In production the seed script
# refuses to run if SEED_ADMIN_PASSWORD is unset or left at this placeholder — set a real one.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-immediately
